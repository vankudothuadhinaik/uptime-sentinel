# Copy to .env.production. Never commit .env.production or paste its secrets into chat.
APP_ENV=production
DOMAIN=uptime.example.com
EMAIL=ops@example.com
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_DB=uptime_sentinel
POSTGRES_USER=uptime_sentinel
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
# Private, independently controlled proxy; never use the public test proxy for production.
EGRESS_PROXY_URL=http://your-private-proxy.internal:3128
EGRESS_PROXY_USERNAME=REPLACE_WITH_RANDOM_PROXY_USERNAME
EGRESS_PROXY_PASSWORD=REPLACE_WITH_RANDOM_PROXY_PASSWORD_AT_LEAST_32_CHARS
ACCESS_TOKEN_MINUTES=30
CHECK_USER_AGENT=UptimeSentinel/0.1
RESULT_RETENTION_DAYS=30
MAX_MONITORS_PER_USER=50
MAX_RESPONSE_BYTES=65536
SENTRY_DSN=
