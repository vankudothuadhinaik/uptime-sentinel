APP_ENV=development
DATABASE_URL=sqlite:///./uptime_sentinel.db
REDIS_URL=redis://localhost:6379/0
# Use redis://redis:6379/1 for shared rate limits across API replicas; memory:// is single-process only.
RATE_LIMIT_STORAGE_URI=memory://
EGRESS_PROXY_URL=
EGRESS_PROXY_USERNAME=
EGRESS_PROXY_PASSWORD=
JWT_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_MINUTES=60
CHECK_USER_AGENT=UptimeSentinel/0.1
RESULT_RETENTION_DAYS=30
MAX_MONITORS_PER_USER=50
MAX_RESPONSE_BYTES=65536
SENTRY_DSN=
# For Docker Compose, replace DATABASE_URL with:
# postgresql+psycopg://uptime:change-me-local-only@postgres:5432/uptime_sentinel
